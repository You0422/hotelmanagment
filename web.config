<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" 
           path="*" 
           verb="*" 
           modules="FastCgiModule" 
           scriptProcessor="C:\Users\Administrator\Documents\hotel_managment\venv\Scripts\python.exe|C:\Users\Administrator\Documents\hotel_managment\venv\Lib\site-packages\wfastcgi.py" 
           resourceType="Unspecified" 
           requireAccess="Script" />
    </handlers>
  </system.webServer>

  <appSettings>
    <add key="PYTHONPATH" value="C:\Users\Administrator\Documents\hotel_managment" />
    <add key="WSGI_HANDLER" value="prohotel.wsgi.application" />
    <add key="DJANGO_SETTINGS_MODULE" value="prohotel.settings" />
	<add key="WSGI_LOG" value="C:\logs\django.log"/>
  </appSettings>
 </configuration>

