# Modèle de configuration. Sur le serveur : copier en « .env » et remplir.
# Ne jamais publier ce fichier rempli : il contient la clé secrète et le mot de passe de la base.

# --- Site ---
DOMAINE=hotel.mondomaine.ci
EMAIL_ADMIN=contact@mondomaine.ci
DJANGO_SECRET_KEY=remplacer-par-une-longue-cle-aleatoire

# --- Base de données externe (Neon, Supabase, Render...) ---
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# --- OU base PostgreSQL sur le serveur lui-même ---
# Utiliser alors : docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d --build
# DATABASE_URL reste vide, ces trois valeurs suffisent :
# POSTGRES_DB=hotelmanagment
# POSTGRES_USER=hotelmanagment
# POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-solide

# --- Autres hébergeurs (Render, Railway...) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=mondomaine.com,www.mondomaine.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mondomaine.com
# Base sur la même machine, sans SSL : DB_SSL_REQUIRE=False
