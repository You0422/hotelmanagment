# Modèle de configuration. Sur le serveur : copier en « .env » et remplir. Ne jamais publier ce fichier rempli.

# --- VPS avec docker compose (voir DEPLOIEMENT-VPS.md) ---
DOMAINE=hotel.mondomaine.ci
EMAIL_ADMIN=contact@mondomaine.ci
DJANGO_SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
POSTGRES_DB=hotelmanagment
POSTGRES_USER=hotelmanagment
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-solide

# --- Autres hébergeurs ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=mondomaine.com,www.mondomaine.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mondomaine.com
# Base fournie par l'hébergeur (Render...) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/hotelmanagment
# Postgres sans SSL (même machine) : DB_SSL_REQUIRE=False
# Champ par champ, si DATABASE_URL est vide :
# DB_ENGINE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
